{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run C# Script",
            "type": "shell",
            "command": "dotnet-script",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "close": false
            }
        }
    ]
}
